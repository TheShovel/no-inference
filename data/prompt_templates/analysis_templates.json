[
    {
        "id": "pros_cons",
        "patterns": [
            "(?:analyze|list|discuss|outline|examine)\\s+(?:the\\s+)?pros\\s+(?:and|&)\\s+cons\\s+(?:of|about|of)\\s+(?P<topic>.+?)(?:\\.\\s*|\\?\\s*|$)"
        ],
        "slots": {"topic": "topic"},
        "response_type": "explanation",
        "weight": 0.95
    },
    {
        "id": "compare_contrast_dimensions",
        "patterns": [
            "(?:compare|contrast)\\s+(?P<topic>.+?)\\s+(?:and|vs|versus|with)\\s+(?P<other>.+?)\\s+(?:across|along|on|in\\s+terms\\s+of)\\s+(?P<dimensions>.+?)\\s*(?:dimensions|aspects|criteria|factors)?(?:\\.\\s*|\\?\\s*|$)"
        ],
        "slots": {"topic": "topic", "other": "other", "dimensions": "dimensions"},
        "response_type": "explanation",
        "weight": 0.95
    },
    {
        "id": "trace_evolution",
