[
    {
        "id": "multi_guide_tutorial_steps",
        "patterns": [
            "(?:write|create|make|build|prepare)\\s+(?:a|an|the)?\\s*(?:comprehensive|detailed|step-by-step|beginner|advanced|complete)?\\s*(?:guide|tutorial|walkthrough|introduction)\\s+(?:to|on|for|about)\\s+(?P<topic>.+?)(?:,\\s*(?:covering|including|with)\\s+(?P<prerequisites>.+?)\\s*(?:prerequisites|requirements|background))?(?:,\\s*(?:and|then)\\s+(?P<steps>.+?)\\s*(?:steps|tasks|exercises))?(?:\\.\\s*|\\?\\s*|$)"
        ],
        "slots": {"topic": "topic", "prerequisites": "prerequisites", "steps": "steps"},
        "response_type": "explanation",
        "weight": 0.9
    },
    {
        "id": "multi_explain_like",
        "patterns": [
            "(?:explain|describe|teach|tell|break\\s*down)\\s+(?P<topic>.+?)\\s+(?:like\\s+I'?m|as\\s+if\\s+I'?m|to\\s+a|for\\s+a|in\\s+)\\s*(?P<audience>.+?)(?:,\\s*(?:covering|focusing\\s+on|while\\s+avoiding)\\s+(?P<focus>.+?))?(?:\\.\\s*|\\?\\s*|$)"
        ],
        "slots": {"topic": "topic", "audience": "audience", "focus": "focus"},
        "response_type": "explanation",
        "weight": 0.9
    },
    {
